{
  "name": "cursor-template",
  "version": "0.1.0",
  "description": "Install aitmpl.com skills, commands, agents, and MCPs for Cursor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "cursor-template": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeneldeasis/cursor-template.git"
  },
  "bugs": {
    "url": "https://github.com/joeneldeasis/cursor-template/issues"
  },
  "homepage": "https://github.com/joeneldeasis/cursor-template#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.js\"",
    "test:coverage": "node scripts/test-coverage.mjs",
    "package:check": "node scripts/check-package.mjs",
    "smoke": "node scripts/pack-smoke.mjs",
    "validate": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:coverage",
    "ci": "npm run validate && npm run package:check && npm pack && npm run smoke",
    "prepublishOnly": "npm run validate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.21",
    "eslint": "^10.11.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1"
  },
  "keywords": [
    "cursor",
    "aitmpl",
    "skills",
    "cli"
  ],
  "license": "MIT"
}
